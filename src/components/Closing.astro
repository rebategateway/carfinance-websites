---
import BrandMark from './BrandMark.astro';
import { CLAIM_URL } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ready to get started?', text = 'Car finance agreements found in seconds!' } = Astro.props;
---
<section class="wrap" style="padding-bottom: var(--section)">
  <div class="closing">
    <BrandMark class="mk" />
    <div class="stack" style="gap:10px">
      <h2 class="d h2">{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <a class="btn" href={CLAIM_URL} rel="sponsored noopener">Find my agreements <span aria-hidden="true">→</span></a>
  </div>
</section>
