---
// Header modelled on CreditRights and Report Repair (Jack, 2 Nov 2026): drop-down
// menus on desktop, a full-screen grouped menu on phones.
import Logo from './Logo.astro';
import { LETTER, CLAIM_URL, NAV_HELP, SITE } from '../data/site';
import type { NavId } from '../data/site';
import { LENDERS, POPULAR, lenderHref, shortName } from '../data/lenders';
interface Props { active?: NavId }
const { active = 'none' } = Astro.props;
const popular = POPULAR.map((s) => LENDERS.find((l) => l.slug === s)!).filter(Boolean);
const helpOn = NAV_HELP.some((h) => h.id === active);
const chev = '<svg class="chev" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header class="hdr">
  <div class="wrap hdr-in">
    <Logo />
    <nav class="nav-wrap" aria-label="Main">
      <ul class="nav">
        <li class="dd dd-wide">
          <button class:list={['nav-btn', { on: active === 'lenders' }]} type="button" aria-expanded="false" aria-controls="dd-lenders" data-dd>Lenders<Fragment set:html={chev} /></button>
          <div class="dd-panel" id="dd-lenders">
            <div class="p-in">
              <div class="p-intro">
                <p class="p-h">Find your lender</p>
                <p class="p-txt">Car finance from 2007 to 2024 with any lender can be checked.</p>
                <a class="btn btn-sm" href="/lenders/">All {LENDERS.length} lenders</a>
              </div>
              <ul class="p-lenders">
                {popular.map((l) => <li><a href={lenderHref(l.slug)}>{shortName(l)}</a></li>)}
              </ul>
            </div>
          </div>
        </li>
        <li><a class="nav-a" href="/how-it-works/" aria-current={active === 'how' ? 'page' : undefined}>How it works</a></li>
        <li><a class="nav-a" href="/fca-redress-scheme/" aria-current={active === 'scheme' ? 'page' : undefined}>The FCA scheme</a></li>
        <li class="dd">
          <button class:list={['nav-btn', { on: helpOn }]} type="button" aria-expanded="false" aria-controls="dd-help" data-dd>Help<Fragment set:html={chev} /></button>
          <div class="dd-panel p-help" id="dd-help">
            <ul>
              {NAV_HELP.map((h) => <li><a href={h.href} aria-current={h.id === active ? 'page' : undefined}>{h.label}</a></li>)}
            </ul>
          </div>
        </li>
      </ul>
    </nav>
    <div class="hdr-act">
      <a class="letter" href={LETTER.href}>{LETTER.label}</a>
      <a class="btn btn-sm" href={CLAIM_URL} rel="sponsored noopener">Find my agreements</a>
    </div>
    <button class="burger" type="button" aria-label="Open menu" aria-haspopup="dialog" data-menu-open>
      <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="2"></path></svg>
    </button>
  </div>
</header>
<dialog class="menu" aria-label="Menu" data-menu>
  <div class="m-bar">
    <Logo />
    <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <div class="m-road" aria-hidden="true"></div>
  <svg class="m-car" viewBox="0 0 28 54" aria-hidden="true"><rect x="0" y="9" width="4" height="10" rx="2" fill="#000"/><rect x="24" y="9" width="4" height="10" rx="2" fill="#000"/><rect x="0" y="37" width="4" height="10" rx="2" fill="#000"/><rect x="24" y="37" width="4" height="10" rx="2" fill="#000"/><rect x="2" y="1" width="24" height="52" rx="9" fill="#04C78D"/><path d="M6 17c5-3 11-3 16 0l-2 8H8z" fill="#07131E"/><path d="M8 40h12l2 6c-5 2-11 2-16 0z" fill="#07131E" opacity=".85"/><rect x="8" y="26" width="12" height="13" rx="3" fill="#C1F7E7" opacity=".35"/><circle cx="7" cy="4.5" r="1.8" fill="#FFF6C8"/><circle cx="21" cy="4.5" r="1.8" fill="#FFF6C8"/></svg>
  <div class="menu-body">
    <ul class="m-main">
      <li style="--i:0"><a href={LETTER.href}>{LETTER.label}</a></li>
      <li style="--i:1"><a href="/how-it-works/">How it works</a></li>
      <li style="--i:2"><a href="/fca-redress-scheme/">The FCA scheme</a></li>
      <li style="--i:3">
        <details class="m-acc">
          <summary>Lenders</summary>
          <div class="m-panel">
            <ul class="m-chips">{popular.map((l) => <li><a href={lenderHref(l.slug)}>{shortName(l)}</a></li>)}</ul>
            <a class="m-all" href="/lenders/">All {LENDERS.length} lenders <span aria-hidden="true">→</span></a>
          </div>
        </details>
      </li>
      <li style="--i:4">
        <details class="m-acc">
          <summary>Help</summary>
          <div class="m-panel">
            <ul class="m-grid">{NAV_HELP.map((h) => <li><a href={h.href}>{h.label}</a></li>)}</ul>
          </div>
        </details>
      </li>
    </ul>
    <p class="m-stat"><b>75,000+</b><span>people helped through our partners</span></p>
  </div>
  <div class="menu-foot">
    <a class="btn btn-block" href={CLAIM_URL} rel="sponsored noopener">Find my agreements <span aria-hidden="true">→</span></a>
    <p class="fine">{SITE.name} · FCA authorised, FRN {SITE.company.frn}</p>
  </div>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu?.showModal());
  // Short fade out before closing (skipped when motion is reduced).
  const shut = () => {
    if (!menu?.open) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return menu.close();
    menu.classList.add('closing');
    setTimeout(() => { menu.close(); menu.classList.remove('closing'); }, 170);
  };
  document.querySelector('[data-menu-close]')?.addEventListener('click', shut);
  menu?.addEventListener('cancel', (e) => { e.preventDefault(); shut(); });
  menu?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) menu.close(); });

  // Drop-downs: click or tap to toggle; hover opens them on mouse devices.
  const items = [...document.querySelectorAll<HTMLElement>('.dd')];
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  let timer = 0;
  const set = (li: HTMLElement, open: boolean) => {
    li.classList.toggle('open', open);
    li.querySelector('[data-dd]')?.setAttribute('aria-expanded', String(open));
    if (!open) li.dataset.hover = '';
  };
  const closeAll = (keep?: HTMLElement) => items.forEach((li) => li !== keep && set(li, false));
  items.forEach((li) => {
    li.querySelector('[data-dd]')?.addEventListener('click', () => {
      const open = !li.classList.contains('open') || li.dataset.hover === '1';
      closeAll(li); set(li, open); li.dataset.hover = '';
    });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(li, false); });
    if (!fine) return;
    li.addEventListener('pointerenter', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => { if (!li.classList.contains('open')) { closeAll(li); set(li, true); li.dataset.hover = '1'; } }, 90);
    });
    li.addEventListener('pointerleave', () => { clearTimeout(timer); timer = window.setTimeout(() => set(li, false), 240); });
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.dd')) closeAll(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = items.find((li) => li.classList.contains('open'));
    if (open) { set(open, false); open.querySelector<HTMLElement>('[data-dd]')?.focus(); }
  });
</script>
