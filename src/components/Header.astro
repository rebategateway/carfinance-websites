---
import Logo from './Logo.astro';
import { NAV, LETTER, CLAIM_URL } from '../data/site';
import type { NavId } from '../data/site';
interface Props { active?: NavId }
const { active = 'none' } = Astro.props;
---
<header class="wrap hdr">
  <Logo />
  <nav class="hdr-nav" aria-label="Main">
    {NAV.map((n) => <a href={n.href} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <div class="hdr-cta">
    <a href={LETTER.href}>{LETTER.label}</a>
    <a class="btn btn-sm" href={CLAIM_URL} rel="sponsored noopener">Check my agreements</a>
  </div>
  <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet" data-menu-open>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
</header>
<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="sheet-hd">
    <Logo />
    <button class="menu-btn" type="button" aria-label="Close menu" data-menu-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="sheet-body">
    <a class="sheet-letter" href={LETTER.href}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      <span><b>Received our letter?</b><br /><span class="small muted">See what it means for you</span></span>
    </a>
    <nav class="sheet-nav" aria-label="Menu">
      {NAV.map((n) => <a href={n.href}>{n.label}<span aria-hidden="true">›</span></a>)}
    </nav>
    <div class="sheet-sub"><a href="/about-us/">About us</a><a href="/contact/">Contact</a><a href="/complaints/">Complaints</a></div>
  </div>
  <div class="sheet-ft"><a class="btn btn-block" href={CLAIM_URL} rel="sponsored noopener">Find my agreements <span aria-hidden="true">→</span></a></div>
</div>
<script>
  const sheet = document.getElementById('sheet');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = () => { sheet!.hidden = true; document.body.style.overflow = ''; opener?.setAttribute('aria-expanded', 'false'); opener?.focus(); };
  opener?.addEventListener('click', () => {
    sheet!.hidden = false; document.body.style.overflow = 'hidden'; opener.setAttribute('aria-expanded', 'true');
    sheet!.querySelector<HTMLElement>('[data-menu-close]')?.focus();
  });
  sheet?.querySelector('[data-menu-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet && !sheet.hidden) close(); });
</script>
