---
// The FCA scheme: the site's main reference page. Facts from PS26/3 and FCA statements; update with SCHEME_UPDATED.
import Base from '../layouts/Base.astro';
import CarHero from '../components/CarHero.astro';
import SchemeRoad from '../components/SchemeRoad.astro';
import EndBand from '../components/EndBand.astro';
import { SITE, FIGURES, SCHEME_UPDATED, FREE_ROUTE } from '../data/site';
const updatedIso = new Date(SCHEME_UPDATED).toISOString().slice(0, 10);
const url = new URL('/fca-redress-scheme/', SITE.url).href;
const article = { '@type': 'Article', '@id': `${url}#article`, headline: 'The FCA car finance redress scheme: where it stands', dateModified: updatedIso, inLanguage: 'en-GB', mainEntityOfPage: { '@id': `${url}#webpage` }, publisher: { '@id': `${SITE.url}/#organization` }, about: { '@type': 'Thing', name: 'FCA motor finance consumer redress scheme (PS26/3)' }, citation: ['https://www.fca.org.uk/news/statements/fca-confirms-motor-finance-redress-scheme', 'https://www.fca.org.uk/publications/policy-statements/ps26-3-motor-finance-consumer-redress-scheme'] };
const KEY = [
  { n: FIGURES.agreements, l: 'agreements eligible' },
  { n: FIGURES.average, l: 'average per agreement' },
  { n: '16 Feb – 3 Mar 2027', l: 'legal challenge heard' },
  { n: FIGURES.deadlineShort, l: 'last day to complain' },
];
const tick = '<svg class="tk" viewBox="0 0 28 28" aria-hidden="true"><rect x="1" y="1" width="26" height="26" rx="6" fill="#04C78D" stroke="#07131E" stroke-width="2"/><path d="M7.5 14.5l4.5 4.5 8.5-9.5" fill="none" stroke="#07131E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const UNFAIR = [
  { t: 'Discretionary commission', p: 'The dealer could set your interest rate and earned more commission the higher it went. Banned from 28 January 2021.' },
  { t: 'High commission', p: 'At least 39% of the interest and charges, and at least 10% of the amount borrowed.' },
  { t: 'A tie to the lender', p: 'The lender had exclusivity or first refusal on the dealer’s customers, and you weren’t told.' },
];
---
<Base path="/fca-redress-scheme/" title={`FCA Car Finance Redress Scheme: Where It Stands | ${SITE.name}`} description={`The FCA's car finance redress scheme covers agreements from 2007 to 2024. Where it stands, the legal challenge, the deadlines and what it pays.`} active="scheme" crumbs={[{ name: 'The FCA scheme', href: '/fca-redress-scheme/' }]} schema={[article]} closing={false}>
  <CarHero slot="hero" car={false} h1="The FCA car finance redress scheme" sub={`It covers car finance from ${FIGURES.from} to ${FIGURES.to} where the lender paid the dealer commission you weren’t told about. Payouts are paused while the rules are challenged.`} meta={`Updated ${SCHEME_UPDATED}`} crumbs={[{ name: 'The FCA scheme', href: '/fca-redress-scheme/' }]} />

  <section class="wrap section">
    <ul class="keyfacts">{KEY.map((k) => <li><b class="d">{k.n}</b><span>{k.l}</span></li>)}</ul>
  </section>

  <SchemeRoad cta={false} heading="Where the scheme is now" />

  <section class="wrap section owed">
    <div class="owed-l">
      <h2 class="d h2">What the scheme is</h2>
      <p>The Financial Conduct Authority confirmed its motor finance consumer redress scheme on 30 March 2026, in policy statement PS26/3. Lenders must review agreements where they paid the dealer or broker commission, and pay compensation where the arrangement was unfair and not properly disclosed.</p>
      <p>It covers PCP and hire purchase taken out between {FIGURES.from} and {FIGURES.to}, in two parts: agreements up to 31 March 2014, and agreements from 1 April 2014.</p>
    </div>
    <div>
      <h3 class="sub-h">What makes commission unfair</h3>
      <ul class="tcards">{UNFAIR.map((o) => <li><Fragment set:html={tick} /><div><h3>{o.t}</h3><p>{o.p}</p></div></li>)}</ul>
    </div>
  </section>

  <section class="tint">
    <div class="wrap section">
      <div class="gtk gtk-3">
        <div><h3>How compensation is worked out</h3><p>For most people it’s based on the commission paid and the FCA’s estimate of how much more it cost you, plus interest at the Bank of England base rate plus 1%, with a minimum of 3% a year. In the most serious cases the lender refunds all the commission, plus interest.</p></div>
        <div><h3>The legal challenge</h3><p>CA Auto Finance, Mercedes-Benz Financial Services, Volkswagen Financial Services and the consumer group Consumer Voice have challenged the rules. On 2 July 2026 the Upper Tribunal suspended parts of the scheme, so no compensation is payable until the challenges are decided. The full hearing is from 16 February to 3 March 2027.</p></div>
        <div><h3>Deadlines</h3><p>While the scheme is paused, lenders don’t have to work out or pay compensation, but they must still tell people who complained if they’re not owed anything: by 18 November 2026 (agreements from April 2014, complained about by 30 June 2026) or 18 January 2027 (older agreements, complained about by 31 August 2026). Offers wait for the ruling. If your lender hasn’t contacted you, you can complain until {FIGURES.deadline}. If a lender writes to you about the scheme, you have six months to reply.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="d h2">Sources</h2>
    <ul class="srcs">
      <li><a href="https://www.fca.org.uk/news/statements/fca-confirms-motor-finance-redress-scheme" rel="noopener">FCA: FCA confirms motor finance redress scheme (30 March 2026)</a></li>
      <li><a href="https://www.fca.org.uk/publications/policy-statements/ps26-3-motor-finance-consumer-redress-scheme" rel="noopener">FCA: PS26/3 Motor finance consumer redress scheme</a></li>
    </ul>
    <p class="fine muted" style="margin-top:14px">{FREE_ROUTE}</p>
  </section>

  <EndBand />
</Base>
