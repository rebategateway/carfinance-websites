---
// Old /cancellation/ wording (Jack, 2 Nov 2026).
import Legal from '../components/Legal.astro';
import { SITE, PARTNER } from '../data/site';
---
<Legal path="/cancellation/" title={`Cancellation | ${SITE.name}`} description={`Notice of right to cancel: ${SITE.name} is an introducer. If you signed with ${PARTNER.legalName}, you cancel with them directly, free within 14 days.`} h1="Cancellation" updated="2 November 2026">
  <h2>Notice of right to cancel</h2>
  <p>{SITE.name} acts as an introducer to certain claim handling partners. It does not provide claim handling services.</p>
  <p>If you have signed a Letter of Authority and/or Terms of Engagement with one of our claim handling partners, you must cancel with them directly. You have a 14-day cooling-off period during which you may cancel your claim without charge.</p>
  <p>If you have signed a Letter of Authority and/or Terms of Engagement with {PARTNER.legalName}, please contact them directly here: <a href="https://consultationclaims.co.uk/cancellation/" rel="noopener">consultationclaims.co.uk/cancellation</a>.</p>
</Legal>
