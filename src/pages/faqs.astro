---
import Base from '../layouts/Base.astro';
import CarHero from '../components/CarHero.astro';
import Faqs from '../components/Faqs.astro';
import EndBand from '../components/EndBand.astro';
import { SITE } from '../data/site';
import { ALL_FAQS, FAQ_GROUPS } from '../data/faqs';
const faqSchema = { '@type': 'FAQPage', mainEntity: ALL_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() } })) };
---
<Base path="/faqs/" title={`Car Finance Claim FAQs | ${SITE.name}`} description="Answers to the most-asked questions about mis-sold car finance claims: who is eligible, discretionary commission, paid-off agreements and what happens next." active="faqs" crumbs={[{ name: 'FAQs', href: '/faqs/' }]} schema={[faqSchema]} closing={false}>
  <CarHero slot="hero" car={false} h1="Got questions?" sub="Answers to the questions we’re asked most about car finance claims." crumbs={[{ name: 'FAQs', href: '/faqs/' }]} />
  {FAQ_GROUPS.map((g, i) => (
    <section class:list={[i % 2 ? 'tint' : '']}>
      <div class="wrap section center">
        <h2 class="d h2">{g.h}</h2>
        <div class="faq-pills"><Faqs items={g.items} /></div>
      </div>
    </section>
  ))}
  <EndBand heading={`Ready? Claim with ${SITE.name}.`} text="Get what you deserve. Agreements found in seconds." />
</Base>
