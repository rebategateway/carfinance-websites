---
import Base from '../layouts/Base.astro';
import HeroCard from '../components/HeroCard.astro';
import Faqs from '../components/Faqs.astro';
import { SITE, FREE_ROUTE, PAYMENT_LINE, PARTNER, FIGURES } from '../data/site';
import { FAQ } from '../data/faqs';
const faqs = [
  { q: 'Why did you write to me?', a: `<p>We write to people who may have had car finance between ${FIGURES.from} and ${FIGURES.to}. We don’t know anything about your agreements when we write. Your letter explains where your details came from.</p>` },
  FAQ.paidOff, FAQ.credit, FAQ.cost,
  { q: 'I don’t want any more letters', a: `<p>Tell us${SITE.email ? ` at <a href="mailto:${SITE.email}">${SITE.email}</a> or` : ''} by post to ${SITE.company.legalName}, ${SITE.company.address.street}, ${SITE.company.address.locality} ${SITE.company.address.postcode}, and we won’t write to you again.</p>` },
];
---
<Base path="/received-a-letter/" title={`Received a letter from ${SITE.name}?`} description={`Had a letter from ${SITE.name} about car finance? Here's why we wrote, what happens next and how to find every agreement in your name. No win, no fee.`} active="letter" crumbs={[{ name: 'Received a letter?', href: '/received-a-letter/' }]}>
  <div slot="hero" class="wrap hero" style="padding-top:0">
    <div class="hero-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Received a letter?</span></nav>
      <h1 class="d h1 sm">Received a letter from us?</h1>
      <p class="lede" style="max-width:38ch">We wrote because you may have had car finance between 2007 and 2024. If the dealer was paid commission you weren’t told about, you could be owed compensation.</p>
      <p class="hero-free">{FREE_ROUTE} {PAYMENT_LINE}</p>
    </div>
    <HeroCard />
  </div>
  <section class="wrap section">
    <div class="sec-head"><h2 class="d h2">What happens next</h2></div>
    <ol class="steps">
      <li><div class="rail"><i></i><u></u></div><div class="body"><h3 class="h3">Enter your details</h3><p>On {PARTNER.name}’ secure page, so your credit file can be searched.</p></div></li>
      <li><div class="rail"><i></i><u></u></div><div class="body"><h3 class="h3">Your agreements are found</h3><p>A soft search finds car finance agreements back to 2007.</p></div></li>
      <li><div class="rail"><i></i></div><div class="body"><h3 class="h3">Each lender gets a complaint</h3><p>{PARTNER.name} complains to each lender for you. No win, no fee.</p></div></li>
    </ol>
  </section>
  <section class="band-mint"><div class="wrap section two-col"><h2 class="d h2">About your letter</h2><Faqs items={faqs} openFirst /></div></section>
</Base>
