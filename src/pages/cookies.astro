---
import Legal from '../components/Legal.astro';
import { SITE } from '../data/site';
---
<Legal path="/cookies/" title={`Cookie policy | ${SITE.name}`} description={`The cookies ${SITE.name} uses. We don't use advertising or analytics cookies, and nothing tracks you across other websites.`} h1="Cookie policy" updated="2 November 2026">
  <p>We don’t use advertising or analytics cookies, and nothing on this site tracks you across other websites.</p>
  <h2>What we use</h2>
  <table>
    <thead><tr><th scope="col">Name</th><th scope="col">What it does</th><th scope="col">How long</th></tr></thead>
    <tbody><tr><td>Cloudflare security cookies</td><td>Our hosting provider may set a strictly necessary cookie to protect the site from bots and attacks.</td><td>Up to 30 minutes</td></tr></tbody>
  </table>
  <p>This is strictly necessary for the site to work safely, so it doesn’t need your consent.</p>
  <h2>If this changes</h2>
  <p>If we add analytics or other optional cookies, we’ll ask for your consent first, with equally clear options to accept or reject, and update this page.</p>
  <h2>Managing cookies</h2>
  <p>You can delete or block cookies in your browser’s settings.</p>
</Legal>
