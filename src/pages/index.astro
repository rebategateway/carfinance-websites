---
// Home, styled on reclaim247 (Jack, 2 Nov 2026): punchy headings, short copy,
// the car as the hero picture. Wording from the old checkfinance.co.uk, shortened.
import Base from '../layouts/Base.astro';
import SchemeRoad from '../components/SchemeRoad.astro';
import Faqs from '../components/Faqs.astro';
import CarHero from '../components/CarHero.astro';
import StatBand from '../components/StatBand.astro';
import OwedCards from '../components/OwedCards.astro';
import HowCards from '../components/HowCards.astro';
import EndBand from '../components/EndBand.astro';
import { SITE, PARTNER, FIGURES, FREE_ROUTE, PAYMENT_LINE, CHOICES_LINE, CLAIM_URL, CREDITRIGHTS, PCPTAX } from '../data/site';
import { SERVICE_SCHEMA } from '../data/site';
import { HOME_FAQS } from '../data/faqs';
import { LENDERS, lenderHref, shortName } from '../data/lenders';
const c = SITE.company;

const title = `${SITE.name} Claims | Car Finance Compensation`;
const description = `Received a letter from ${SITE.name}? You may be eligible for compensation for mis-sold car finance. Find your agreements from 2007 to 2024. No win, no fee.`;
const faqSchema = { '@type': 'FAQPage', mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() } })) };

const lenders = [...LENDERS].sort((a, b) => a.name.localeCompare(b.name));
---
<Base path="/" title={title} description={description} schema={[faqSchema, SERVICE_SCHEMA]} closing={false}>
  <CarHero slot="hero" h1={`Received a letter from ${SITE.name}?`} sub="You may be eligible for compensation for mis-sold car finance." />

  <StatBand />

  <OwedCards />

  <HowCards />

  <section class="wrap section center">
    <h2 class="d h2">Every major lender</h2>
    <p class="lead-c">Black Horse, Santander, MotoNovo, Close Brothers and more. Pick yours to see where it stands.</p>
    <ul class="lchips">
      {lenders.map((l) => <li><a href={lenderHref(l.slug)}>{shortName(l)}</a></li>)}
    </ul>
    <a class="more" href="/lenders/">All {LENDERS.length} lenders</a>
  </section>

  <section class="wrap" style="padding-bottom: var(--section)">
    <div class="xsell">
      <div>
        <h2 class="d">Struggled with other credit?</h2>
        <p>If a lender gave you an overdraft, card, loan or catalogue account you couldn’t afford, you could get back the interest and charges. Our sister service {CREDITRIGHTS.name} handles these claims.</p>
      </div>
      <div class="xsell-b">
        <a class="btn btn-inv" href={CREDITRIGHTS.url} rel="noopener">Visit CreditRights <span aria-hidden="true">→</span></a>
        <a href={CREDITRIGHTS.page}>What counts as irresponsible lending</a>
      </div>
    </div>
    <div class="xsell" style="margin-top:12px">
      <div>
        <h2 class="d">Compensation taxed?</h2>
        <p>Lenders take tax off the interest in car finance compensation. Most basic-rate and non-taxpayers can get it back from HMRC, and {PCPTAX.name} can claim it for you.</p>
      </div>
      <div class="xsell-b">
        <a class="btn btn-inv" href={PCPTAX.url} rel="noopener">Visit PCPTaxRebates <span aria-hidden="true">→</span></a>
        <a href={PCPTAX.page}>How the tax rebate works</a>
      </div>
    </div>
  </section>

  <SchemeRoad heading="Where the FCA scheme is now" />

  <section class="wrap section">
    <h2 class="d h2">Good to know</h2>
    <div class="gtk">
      <div><h3>No win, no fee</h3><p>You pay nothing unless your claim is successful. A fee between 18 and 36% including VAT applies on successful claims, depending on the redress secured. A cancellation fee may apply after the 14-day cooling-off period. <a href="/fees/">See fees</a>.</p></div>
      <div><h3>Your choices</h3><p>{CHOICES_LINE}</p></div>
      <div><h3>Who we are</h3><p>{SITE.name} is a trading style of {c.legalName}, a claims management company authorised and regulated by the FCA ({c.frn}). We introduce you to {PARTNER.legalName} (FRN {PARTNER.frn}), who handle your claim. {PAYMENT_LINE} <a href="/about-us/">About us</a>.</p></div>
      <div><h3>FCA update</h3><p>The FCA has confirmed a redress scheme for car finance, but payouts are on hold until a legal challenge is heard from 16 February to 3 March 2027. The last day to complain is {FIGURES.deadline}. <a href="/fca-redress-scheme/">Latest update</a>.</p></div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap section center">
      <h2 class="d h2">Got questions?</h2>
      <div class="faq-pills"><Faqs items={HOME_FAQS} /></div>
      <a class="more" href="/faqs/">All questions</a>
    </div>
  </section>

  <EndBand />
</Base>
