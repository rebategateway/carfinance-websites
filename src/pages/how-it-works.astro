---
// How it works, in the home page style (Jack, 2 Nov 2026). Wording from the old /how-to-claim/, shortened.
import Base from '../layouts/Base.astro';
import CarHero from '../components/CarHero.astro';
import StatBand from '../components/StatBand.astro';
import HowCards from '../components/HowCards.astro';
import EndBand from '../components/EndBand.astro';
import Faqs from '../components/Faqs.astro';
import { SITE, PARTNER, FREE_ROUTE, PAYMENT_LINE, CLAIM_URL } from '../data/site';
import { FAQ } from '../data/faqs';
const tick = '<svg class="tk" viewBox="0 0 28 28" aria-hidden="true"><rect x="1" y="1" width="26" height="26" rx="6" fill="#04C78D" stroke="#07131E" stroke-width="2"/><path d="M7.5 14.5l4.5 4.5 8.5-9.5" fill="none" stroke="#07131E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const QUESTIONS = [
  { t: 'PCP or hire purchase?', p: 'Did you take out a PCP or HP agreement between April 2007 and November 2024?' },
  { t: 'Commission kept quiet?', p: 'Were you told the dealer or broker would be paid commission for arranging it?' },
  { t: 'Dealer set the rate?', p: 'Did you know they could set or adjust your interest rate?' },
  { t: 'Terms and fees unclear?', p: 'Were the terms, fees and charges explained to you up front?' },
  { t: 'Pressure to sign?', p: 'Did you feel pressured, or were you shown only one finance option?' },
  { t: 'Thought you’d own the car?', p: 'Did you think you’d own the car at the end of your PCP?' },
];
const NEXT = [
  { t: 'You sign up with ' + PARTNER.name, p: 'If you choose to go ahead, you agree their terms and get a confirmation email.' },
  { t: 'Your lender gets a complaint', p: `${PARTNER.name} writes to each lender to make a claim on your behalf.` },
  { t: 'The lender replies', p: 'Your lender acknowledges the complaint and looks into it.' },
  { t: 'You get a decision', p: 'Payouts under the FCA’s scheme are on hold until the legal challenge is decided in 2027.' },
];
const faqs = [FAQ.process, FAQ.after, FAQ.paidOff, FAQ.used];
---
<Base path="/how-it-works/" title={`How It Works | ${SITE.name} | Car Finance Claims`} description={`If you believe you may have been mis-sold a car finance agreement, compensation could be just around the corner. ${SITE.name} can help you make a claim.`} active="how" crumbs={[{ name: 'How it works', href: '/how-it-works/' }]} closing={false}>
  <CarHero slot="hero" car={false} h1="How to claim" sub="Mis-sold car finance? Compensation could be just around the corner. It takes a few minutes to start." crumbs={[{ name: 'How it works', href: '/how-it-works/' }]} />

  <StatBand />

  <HowCards />

  <section class="wrap section">
    <div class="narrow center">
      <h2 class="d h2">Questions to ask yourself</h2>
      <p class="lead-c">Mis-selling isn’t just paying too much. It’s not getting the full picture. If you answer yes to any of these, check your agreements.</p>
      <ul class="tcards" style="width:100%;text-align:left">
        {QUESTIONS.map((o) => <li><Fragment set:html={tick} /><div><h3>{o.t}</h3><p>{o.p}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="tint">
    <div class="wrap section center">
      <h2 class="d h2">What happens next</h2>
      <ol class="tl">{NEXT.map((n) => <li><div><h3>{n.t}</h3><p>{n.p}</p></div></li>)}</ol>
      <p class="fine muted narrow" style="margin-top:18px">No win, no fee: you typically pay 30% + VAT (36% including VAT) of any amount recovered, never more, and it may be less. A cancellation fee may apply outside the cooling-off period. {FREE_ROUTE} {PAYMENT_LINE}</p>
    </div>
  </section>

  <section class="wrap section center">
    <h2 class="d h2">Got questions?</h2>
    <div class="faq-pills"><Faqs items={faqs} /></div>
    <a class="more" href="/faqs/">All questions</a>
  </section>

  <EndBand />
</Base>
